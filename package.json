{
  "name": "pluribus",
  "version": "0.1.0",
  "description": "Agent Organization System - Orchestrate AI agents, workflows, and MCP tools",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "desktop:dev": "vite",
    "desktop:build": "vite build",
    "desktop:preview": "vite preview",
    "desktop:typecheck": "tsc --noEmit -p tsconfig.desktop.json",
    "desktop:check:rust": "cd src-tauri && cargo check --lib",
    "desktop:test:parser": "bun test src/lib/ndjson-parser.test.ts",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration --timeout 120000",
    "test:migrations": "bun test tests/integration/db/migrations.test.ts --timeout 120000",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@tanstack/react-query": "^5.90.20",
    "@tauri-apps/api": "^2.10.1",
    "bullmq": "^5.20.0",
    "drizzle-orm": "^0.38.0",
    "handlebars": "^4.7.8",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "openai": "^4.70.0",
    "pg": "^8.13.0",
    "postgres": "^3.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testcontainers/postgresql": "^10.13.0",
    "@testcontainers/redis": "^10.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.1.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "drizzle-kit": "^0.30.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "testcontainers": "^10.13.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
