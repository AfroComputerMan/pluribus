# ====================
# Application
# ====================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ====================
# Database
# ====================
DATABASE_URL=postgres://pluribus:pluribus@localhost:5432/pluribus
POSTGRES_USER=pluribus
POSTGRES_PASSWORD=pluribus
POSTGRES_DB=pluribus

# ====================
# Redis
# ====================
REDIS_URL=redis://localhost:6379

# ====================
# Security
# ====================
# Generate with: openssl rand -hex 32
VAULT_MASTER_KEY=your-32-byte-hex-key-here-generate-it

# ====================
# OAuth - Claude Code (Anthropic)
# ====================
# ANTHROPIC_CLIENT_ID=
# ANTHROPIC_CLIENT_SECRET=
# ANTHROPIC_REDIRECT_URI=http://localhost:3000/api/integrations/claude-code/callback

# ====================
# OAuth - Codex (OpenAI)
# ====================
# OPENAI_CLIENT_ID=
# OPENAI_CLIENT_SECRET=
# OPENAI_REDIRECT_URI=http://localhost:3000/api/integrations/codex/callback

# ====================
# API Keys (Fallback)
# ====================
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ====================
# Production Only
# ====================
# DOMAIN=pluribus.example.com
# ACME_EMAIL=admin@example.com
# TRAEFIK_AUTH=admin:$apr1$hash (generate with: htpasswd -nb admin password)
# VERSION=1.0.0
