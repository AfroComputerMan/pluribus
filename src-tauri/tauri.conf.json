{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluribus",
  "version": "0.1.0",
  "identifier": "com.pluribus.desktop",
  "build": {
    "beforeDevCommand": "bun run desktop:dev",
    "beforeBuildCommand": "bun run desktop:build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pluribus",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "sql": {
      "preload": ["sqlite:pluribus.db"]
    }
  }
}
