{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default permissions for Pluribus Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-hide",
    "shell:allow-execute",
    "shell:allow-spawn",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:allow-read",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-read-dir"
  ]
}
